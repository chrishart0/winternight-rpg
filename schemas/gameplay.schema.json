{
  "$defs": {
    "AIProfileSpec": {
      "additionalProperties": false,
      "properties": {
        "behavior": {
          "description": "AI behavior. march emits only Move_to toward destination and never emits an Attack behavior.",
          "enum": [
            "pursue",
            "do_nothing",
            "patrol",
            "march"
          ],
          "title": "Behavior",
          "type": "string"
        },
        "destination": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required destination tile for patrol and non-attacking march AI.",
          "title": "Destination"
        },
        "detection_radius": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detection Radius"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "behavior"
      ],
      "title": "AIProfileSpec",
      "type": "object"
    },
    "ExperienceSpec": {
      "additionalProperties": false,
      "properties": {
        "curve": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Curve",
          "type": "number"
        },
        "kill_multiplier": {
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Kill Multiplier",
          "type": "number"
        },
        "magnitude": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Magnitude",
          "type": "number"
        },
        "minimum": {
          "maximum": 100,
          "minimum": 0,
          "title": "Minimum",
          "type": "integer"
        }
      },
      "required": [
        "magnitude",
        "curve",
        "kill_multiplier",
        "minimum"
      ],
      "title": "ExperienceSpec",
      "type": "object"
    },
    "ItemDefinition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "exp_on_use": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Exp On Use",
          "type": "integer"
        },
        "heal_amount": {
          "default": 0,
          "maximum": 99,
          "minimum": 0,
          "title": "Heal Amount",
          "type": "integer"
        },
        "hit": {
          "default": 100,
          "maximum": 200,
          "minimum": 0,
          "title": "Hit",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "weapon",
            "healing",
            "healing_spell",
            "supply"
          ],
          "title": "Kind",
          "type": "string"
        },
        "map_target_cast_anim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Map Target Cast Anim"
        },
        "max_range": {
          "default": 1,
          "maximum": 10,
          "minimum": 0,
          "title": "Max Range",
          "type": "integer"
        },
        "might": {
          "default": 0,
          "maximum": 99,
          "minimum": 0,
          "title": "Might",
          "type": "integer"
        },
        "min_range": {
          "default": 1,
          "description": "Minimum targeting distance. Defaults to 1; author 0 on a healing item when its user must remain a legal target.",
          "maximum": 10,
          "minimum": 0,
          "title": "Min Range",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "unbreakable": {
          "default": false,
          "description": "Omit LT's uses component entirely so the item never breaks and no menu renders a durability count. Cannot be combined with uses.",
          "title": "Unbreakable",
          "type": "boolean"
        },
        "uses": {
          "default": 1,
          "maximum": 99,
          "minimum": 1,
          "title": "Uses",
          "type": "integer"
        },
        "weapon_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weapon Type"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "kind"
      ],
      "title": "ItemDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ai_profiles": {
      "items": {
        "$ref": "#/$defs/AIProfileSpec"
      },
      "title": "Ai Profiles",
      "type": "array"
    },
    "experience": {
      "$ref": "#/$defs/ExperienceSpec"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ItemDefinition"
      },
      "title": "Items",
      "type": "array"
    },
    "schema_version": {
      "const": "0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "weapon_types": {
      "items": {
        "type": "string"
      },
      "title": "Weapon Types",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "weapon_types",
    "items",
    "ai_profiles",
    "experience"
  ],
  "title": "GameplaySpec",
  "type": "object"
}
