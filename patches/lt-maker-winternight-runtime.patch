 import logging

+def _forced_tutorial_move():
+    """Return (unit nid, destination) while a tutorial locks one unit's move."""
+    unit_nid = game.level_vars.get("_forced_move_unit")
+    raw_position = game.level_vars.get("_forced_move_position")
+    if not unit_nid or raw_position is None:
+        return None
+    try:
+        if isinstance(raw_position, str):
+            position = tuple(int(value) for value in raw_position.split(","))
+        else:
+            position = tuple(raw_position)
+        if len(position) != 2:
+            raise ValueError(raw_position)
+    except (TypeError, ValueError):
+        logging.error("Invalid forced tutorial move position: %r", raw_position)
+        return None
+    return str(unit_nid), position
+
+
+def _remaining_player_unit_count():
+    return sum(
+        1
+        for unit in game.get_player_units()
+        if unit.position
+        and not unit.finished
+        and "Tile" not in unit.tags
+        and skill_system.can_select(unit)
+    )
+
+
+def _remaining_units_prompt(count):
+    noun = "unit" if count == 1 else "units"
+    return (
+        f"You still have {count} {noun} to move. "
+        "Are you sure you want to end your turn?"
+    )
+
+
+def _hide_forced_move_layer():
+    layer_nid = game.level_vars.get("_forced_move_layer")
+    layer = game.tilemap.layers.get(layer_nid) if layer_nid else None
+    if layer and layer.visible:
+        action.do(action.HideLayer(layer_nid, "immediate"))
+
+
