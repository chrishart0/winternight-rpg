+    def emphasize_obj_info(self, disp):
+        """Blink the objective panel, then shrink it back to its settled size.
+
+        Returns None while the panel is blinked out. Content requests one pulse
+        by setting the `_objective_flash` level var; there is no styling change
+        once the pulse finishes.
+        """
+        if self.obj_pulse_start is None:
+            return disp
+        grow_start, grow_end = self.obj_pulse_grow
+        elapsed = engine.get_time() - self.obj_pulse_start
+        if elapsed < 0 or elapsed >= grow_end:
+            self.obj_pulse_start = None
+            return disp
+        if any(start <= elapsed < end for start, end in self.obj_pulse_blinks):
+            return None
+        if elapsed < grow_start:
+            scale = self.obj_pulse_scale
+        else:
+            remaining = (grow_end - elapsed) / (grow_end - grow_start)
+            scale = 1 + (self.obj_pulse_scale - 1) * remaining
+        return image_mods.resize(disp, (scale, scale))
+
     def prepare_attack_info(self):
